<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Project-local package cache so restoring Mutagen never touches the machine-wide cache. -->
  <config>
    <add key="globalPackagesFolder" value="../../vendor/nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
